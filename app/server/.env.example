# Пример окружения сервера (app/server). Скопируйте в app/server/.env и заполните локально.
# В примере только имена ключей и заглушки: реальные значения в репозиторий не попадают.
# Обязательные ключи не закомментированы, необязательные закомментированы и показывают значение по умолчанию.
# Скрипт scripts/check-env-contract.mjs (входит в yarn verify) сверяет этот файл с кодом.
#
# ВАЖНО: DATABASE_URL для разработки указывает на локальную тестовую базу.
# Адрес боевой базы сюда не вписывается: ни для запуска, ни для миграций, ни для тестов.
# Тесты и e2e сами поднимают одноразовую базу и не читают этот файл.

# --- Общее ---
NODE_ENV=development
PORT=4000
# Адрес web, которому разрешён CORS (несколько адресов через запятую)
ALLOWED_ORIGIN=http://localhost:3000
# Подробный вывод загрузки окружения и пула соединений (1 включает)
# DEBUG_ENV=0
# Уровень логов: debug, info, warn, error
# LOG_LEVEL=info
# Предел размера JSON-тела запроса
# JSON_BODY_LIMIT=10mb

# --- База данных ---
# Локальная база разработки, например postgresql://пользователь:пароль@localhost:5432/имя_базы
DATABASE_URL=postgresql://
# Принудительно включить SSL для соединения с базой (1 включает)
# PG_FORCE_SSL=0
# Пул и таймауты соединений (миллисекунды там, где в имени _MS)
# PG_POOL_MAX=2
# PG_MAX_USES=200
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_QUERY_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_KEEPALIVE_DELAY_MS=10000
# Повторять выбранные читающие запросы один раз при временной ошибке базы (0 выключает)
# DB_QUERY_RETRY=1

# --- Авторизация ---
# Секрет подписи JWT: случайная строка не короче 32 символов, например из openssl rand -base64 48
AUTH_JWT_SECRET=
# Имя cookie сессии; web и сервер должны использовать одно и то же имя (по умолчанию bio_exam_session)
# SESSION_COOKIE_NAME=<имя cookie>
# Срок сессии в днях: целое от 1 до 365, по умолчанию 30; другое значение останавливает сервер при старте
# SESSION_MAX_AGE_DAYS=30
# Срок жизни access-токена в секундах: целое от 60 до 3600, по умолчанию 900; другое значение останавливает сервер при старте
# ACCESS_TOKEN_EXPIRES_SEC=900
# Срок жизни refresh-токена в днях: целое от 1 до 365, по умолчанию SESSION_MAX_AGE_DAYS; другое значение останавливает сервер при старте
# REFRESH_TOKEN_EXPIRES_DAYS=30
# Создание первого администратора командой yarn workspace @bio-exam/server bootstrap:admin
# ADMIN_BOOTSTRAP_LOGIN=<логин администратора>
# ADMIN_BOOTSTRAP_PASSWORD_HASH=<bcrypt-хеш пароля>
# ADMIN_BOOTSTRAP_PASSWORD=<пароль для разработки>

# --- Хранилище файлов ---
# Драйвер хранилища: local — каталог на диске (STORAGE_LOCAL_DIR), supabase — Supabase Storage.
# Без значения выбирается Supabase, если заданы SUPABASE_URL и SUPABASE_SERVICE_KEY; иначе сервер отвечает
# ошибкой конфигурации при первом обращении к файлам.
# Значение memory и выбор памяти по умолчанию работают только в изолированном режиме тестов.
# STORAGE_DRIVER=local
# Абсолютный путь каталога для драйвера local
# STORAGE_LOCAL_DIR=<абсолютный путь к каталогу>
# Supabase Storage: адрес проекта, сервисный ключ и имя бакета (по умолчанию main)
# SUPABASE_URL=<адрес проекта Supabase>
# SUPABASE_SERVICE_KEY=<сервисный ключ>
# SUPABASE_STORAGE_BUCKET=main

# --- Тесты и изоляция ---
# Эти ключи ставят скрипты тестов и e2e (yarn verify, yarn e2e, scripts/with-test-db.mjs), вручную их не задают.
# Изолированный режим: сервер не читает файлы окружения и берёт адрес базы только из TEST_DATABASE_URL
# BIO_EXAM_ISOLATED_ENV=1
# Адрес одноразовой локальной базы test_*: хост localhost или 127.0.0.1, имя базы test_...
# TEST_DATABASE_URL=<адрес локальной базы test_*>
