# --- Common ---
NODE_ENV=development
PORT=4000
ALLOWED_ORIGIN=http://localhost:3000
DEBUG_ENV=1

# --- DB ---
DATABASE_URL=postgresql://
# For Supabase use pooled URL with SSL, e.g.:
# DATABASE_URL=postgresql://user:pass@aws-*.pooler.supabase.com:6543/postgres?sslmode=require
# Optional pool/client timeouts (ms)
# PG_POOL_MAX=2
# PG_MAX_USES=200
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_QUERY_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_KEEPALIVE_DELAY_MS=10000
# Retry selected read queries once on transient DB errors
# DB_QUERY_RETRY=1

# --- Auth ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-in-production
ADMIN_BOOTSTRAP_LOGIN=admin
ADMIN_BOOTSTRAP_PASSWORD=change-me-in-production

AUTH_JWT_SECRET=generate-random-secret-at-least-32-chars
SESSION_COOKIE_NAME=itsdoc_session
SESSION_MAX_AGE_DAYS=30
# Enable DB-based RBAC overrides in development if needed
# RBAC_USE_DB_OVERRIDES=1
# Force DB check on each request session validation (default in prod)
# AUTH_SESSION_ENFORCE_DB=1

# --- Documents ---
DOCS_ROOT=../../md
