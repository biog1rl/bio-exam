{
	"name": "@bio-exam/server",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "rimraf dist && tsc -p tsconfig.json",
		"start": "node --enable-source-maps dist/index.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"lint": "oxlint -c ../../.oxlintrc.json src",
		"drizzle:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"drizzle:migrate": "tsx src/scripts/apply-migration.ts",
		"drizzle:studio": "drizzle-kit studio --config=drizzle.config.ts",
		"seed": "tsx src/db/seed.ts",
		"search:backfill": "tsx src/scripts/backfill-question-search.ts",
		"bootstrap:admin": "tsx src/scripts/bootstrap-admin.ts"
	},
	"dependencies": {
		"@bio-exam/rbac": "workspace:*",
		"@supabase/supabase-js": "^2.93.1",
		"archiver": "^7.0.1",
		"bcryptjs": "^3.0.2",
		"chokidar": "^4.0.3",
		"cors": "^2.8.5",
		"cyrillic-to-translit-js": "^3.2.1",
		"dotenv": "^16.4.5",
		"drizzle-orm": "0.45.3",
		"express": "^4.22.3",
		"file-type": "^22.0.0",
		"helmet": "^8.1.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.4.0",
		"pg": "^8.16.3",
		"pino": "^10.0.0",
		"pino-http": "^11.0.0",
		"remove-markdown": "^0.6.2",
		"sharp": "^0.35.5",
		"zod": "^3.24.3"
	},
	"devDependencies": {
		"@types/archiver": "^7.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.0.0",
		"@types/node": "^25.0.3",
		"@types/pg": "^8.15.5",
		"@vercel/node": "^3.0.22",
		"drizzle-kit": "0.31.11",
		"oxlint": "1.86.0",
		"rimraf": "^6.0.1",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "8.3.2",
		"vitest": "5.0.3"
	},
	"engines": {
		"node": "24"
	},
	"packageManager": "yarn@4.12.0"
}
