# Пример окружения web (app/web). Скопируйте в app/web/.env и заполните локально.
# В примере только имена ключей и заглушки: реальные значения в репозиторий не попадают.
# Обязательные ключи не закомментированы, необязательные закомментированы и показывают значение по умолчанию.
# Скрипт scripts/check-env-contract.mjs (входит в yarn verify) сверяет этот файл с кодом.
#
# ВАЖНО: DATABASE_URL для разработки указывает на локальную тестовую базу.
# Адрес боевой базы сюда не вписывается: ни для запуска, ни для тестов.

# --- Общее ---
# Адрес Express-сервера, на который web проксирует /api
API_ORIGIN=http://localhost:4000
# Публичный адрес web, из него строятся абсолютные ссылки
# APP_ORIGIN=http://localhost:3000
# NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- База данных ---
# Временный ключ: web читает базу напрямую только в getMeData, прямой доступ уйдёт из web в фазе 4 (ADR-0001).
# Локальная база разработки, например postgresql://пользователь:пароль@localhost:5432/имя_базы
DATABASE_URL=postgresql://
# Принудительно включить SSL для соединения с базой (1 включает)
# PG_FORCE_SSL=0
# Пул и таймауты соединений (миллисекунды там, где в имени _MS)
# PG_POOL_MAX=2
# PG_MAX_USES=200
# PG_CONNECTION_TIMEOUT_MS=5000
# PG_QUERY_TIMEOUT_MS=10000
# PG_STATEMENT_TIMEOUT_MS=10000
# PG_KEEPALIVE_DELAY_MS=10000

# --- Авторизация ---
# Временный ключ, как и DATABASE_URL, уйдёт из web в фазе 4 (ADR-0001).
# Секрет подписи JWT: тот же, что в app/server/.env, случайная строка не короче 32 символов
AUTH_JWT_SECRET=
# Имя cookie сессии; web и сервер должны использовать одно и то же имя (по умолчанию bio_exam_session)
# SESSION_COOKIE_NAME=<имя cookie>
# Устаревшие ключи NextAuth, оставлены для обратной совместимости и не нужны для запуска
# NEXTAUTH_SECRET=<секрет>
# NEXTAUTH_LOGIN=<логин>
# NEXTAUTH_PASSWORD=<пароль>
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_URL_IP=http://localhost:3000
