{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript"],
	"categories": {
		"correctness": "warn"
	},
	"rules": {
		"no-unused-vars": [
			"warn",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		],
		"no-debugger": "error"
	},
	"ignorePatterns": ["dist/", "node_modules/", "drizzle/"]
}
