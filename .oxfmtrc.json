{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"trailingComma": "es5",
	"semi": false,
	"singleQuote": true,
	"endOfLine": "lf",
	"printWidth": 120,
	"sortTailwindcss": {
		"stylesheet": "./app/web/styles/globals.css",
		"functions": ["clsx", "cn", "cva"]
	},
	"sortImports": {
		"newlinesBetween": true,
		"ignoreCase": false,
		"internalPattern": ["@/"],
		"groups": ["scoped", "react-scan", "react", ["builtin", "external"], "internal", ["parent", "sibling", "index"]],
		"customGroups": [
			{ "groupName": "scoped", "elementNamePattern": ["@[a-z]*/**"] },
			{ "groupName": "react-scan", "elementNamePattern": ["react-scan"] },
			{ "groupName": "react", "elementNamePattern": ["react", "react/*", "react-*", "react-*/**"] }
		]
	},
	"ignorePatterns": [
		"**/drizzle/**",
		"**/.next/**",
		"**/dist/**",
		"**/coverage/**",
		"**/logs/**",
		"app/web/public/**",
		"app/web/components.json",
		"app/web/.vscode/**",
		".yarn/**",
		"**/*.pen",
		"yarn.lock",
		".yarnrc.yml",
		".planning/**",
		".codegraph/**"
	]
}
